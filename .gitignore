# .gitignore for ALGEBRA-
# Python project + markdown curriculum. Grouped so it is easy to extend.

# --- Python bytecode and caches -------------------------------------------
__pycache__/
*.py[cod]
*$py.class

# --- Virtual environments --------------------------------------------------
.venv/
venv/
env/
ENV/

# --- Packaging and build artifacts ----------------------------------------
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/
wheels/
*.whl

# --- Tool caches (pytest, mypy, ruff, hypothesis) -------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# --- Coverage reports ------------------------------------------------------
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- Jupyter notebooks -----------------------------------------------------
.ipynb_checkpoints/
# Tip: clear notebook outputs before committing (e.g. with nbstripout) so
# diffs stay small and no stray local paths or data leak into the repo.

# --- Secrets and local configuration ---------------------------------------
# Nothing in this project needs secrets today, but ignore them by default.
.env
.env.*
!.env.example
*.pem
*.key

# --- Editors and IDEs ------------------------------------------------------
.idea/
.vscode/*
# Share useful workspace settings if you add them deliberately.
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~

# --- Operating system files ------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Local scratch work ----------------------------------------------------
# Throwaway experiments that should not be committed.
scratch/
tmp/
*.log
